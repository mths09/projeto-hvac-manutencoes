<IfModule mod_authz_core.c> Require all denied </IfModule>
<IfModule !mod_authz_core.c> Order allow,deny Deny from all </IfModule>

Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY" Header always set
  X-Content-Type-Options "nosniff" Header always set Referrer-Policy
  "strict-origin-when-cross-origin" Header always set Permissions-Policy
  "camera=(), microphone=(), geolocation=()" Header always set
  Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action
  'self'; frame-ancestors 'none'; img-src 'self' data:; script-src 'self';
  style-src 'self' https://fonts.googleapis.com; font-src 'self'
  https://fonts.gstatic.com; connect-src 'self'"
</IfModule>
